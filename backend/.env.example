# Local SQLite; paths are relative to this project's directory.
FLASK_ENV=development
DATABASE_ENGINE=sqlite
# DATABASE_URL=sqlite:///database/cqa.db
PORT=6767
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Docker Compose uses PostgreSQL regardless of DATABASE_ENGINE.
POSTGRES_DB=cqa
POSTGRES_USER=cqa
# Set your own password before starting Compose.
POSTGRES_PASSWORD=

# Signed Freedom DEV URL. Keep the actual value only in the local .env.
FREEDOM_API_URL=

# Ollama is managed separately. Use the installed model's exact tag.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
