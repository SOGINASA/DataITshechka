[Unit]
Description=Deploy BimBomBam backend from master
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/BimBomBam
ExecStart=/usr/bin/bash /root/BimBomBam/backend/deploy/deploy.sh
Environment=GIT_TERMINAL_PROMPT=0
UMask=0077
TimeoutStartSec=20min
